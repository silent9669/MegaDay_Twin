# Mẫu cấu hình backend (01 §6, 07 §9, 10 §7). Chép thành .env rồi điền.
# KHÔNG commit .env. Đường dẫn tương đối tính từ thư mục backend/.

APP_ENV=dev
DUCKDB_PATH=data/megaday.duckdb
DATA_DIR=../mock-data/out/demo                # thư mục lịch sử để ingest (alias cũ: MOCK_DATA_ROOT)
LIVE_DIR=../mock-data/out/demo/live_stream    # alias cũ: LIVE_ROOT
LIVE_ENABLED=true
LIVE_POLL_SECONDS=2
DISPLAY_TZ=Asia/Ho_Chi_Minh
PLATFORM_FEE_RATE=0.12
SHOP_ID=shop-demo

OPENAI_API_KEY=
# Không hardcode tên model trong code. Kiểm danh sách model + bảng giá OpenAI
# hiện tại trước khi điền, ghi ngày kiểm vào đây (07 §8).
OPENAI_MODEL_REASONING=                       # agent điều tra, what-if khó
OPENAI_MODEL_FAST=                            # ghép cột, phân loại, trích ý định
OPENAI_MODEL_EMBED=                           # embedding gợi ý ghép SKU (để trống = tắt)
AI_ENABLED=true                               # false → app chạy đủ, tắt phần hỏi đáp
AI_MODE=live                                  # live | record | replay
AI_DAILY_TOKEN_BUDGET=2000000
AI_SESSION_TOKEN_BUDGET=50000
AI_DEMO_CACHE=true

DEMO_MODE=true
MC_SAMPLES=1000
RECOMPUTE_TOP_N=50
ORC_WORKERS=4
LOG_LEVEL=INFO
LOG_JSON=true                                 # false → log dạng dễ đọc khi dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
