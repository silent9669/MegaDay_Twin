# Sao chép thành .env.local rồi sửa theo máy mình (.env.local không được commit).

# Gốc API. Mặc định "/api/v1": khi chạy `npm run dev`, Vite proxy /api sang VITE_PROXY_TARGET.
# Khi deploy tách miền, đặt URL đầy đủ, ví dụ https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# Backend cho proxy dev (chỉ vite.config.ts đọc, không vào bundle).
VITE_PROXY_TARGET=http://localhost:8000

# true = không gọi backend, đọc fixture JSON trong src/api/fixtures (lấy từ ví dụ ở docs/dev-plan/08-api.md).
VITE_USE_FIXTURES=false

# Người dùng giả gửi qua header X-User / X-Role (bản hackathon không có mật khẩu, xem 08 §1).
VITE_DEV_USER=u-ops-1
VITE_DEV_USER_NAME=Lan
VITE_DEV_ROLE=operator

# Dùng bởi `npm run gen:api`. Để trống thì thử lần lượt
# http://localhost:8000/api/v1/openapi.json rồi http://localhost:8000/openapi.json
OPENAPI_URL=
