{
  "name": "megaday-twin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:cloudflare": "tsc --noEmit && cf build --mode cloudflare",
    "deploy:cloudflare": "cf deploy --prebuilt --mode cloudflare",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "node --test ../scripts/deployment.test.cjs && npm run prepare:sources && npm run lint && npm test && npm --ignore-scripts run build:cloudflare && npm run deploy:cloudflare -- --dry-run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "gen:api": "node scripts/gen-api.mjs",
    "prepare:sources": "tsx scripts/prepare-sources.ts",
    "prebuild": "npm run prepare:sources",
    "prebuild:cloudflare": "npm run prepare:sources",
    "dev:cloudflare": "vite --mode cloudflare --host 127.0.0.1",
    "deploy": "npm run build:cloudflare && npm run deploy:cloudflare",
    "test:smoke": "node qa/smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "5.105.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "1.64.0",
    "motion": "^14.9.0",
    "papaparse": "^5.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "7.18.5",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "cf": "1.0.0-beta.26",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.62.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "wrangler": "^4.153.0"
  }
}
